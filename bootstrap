#!/bin/sh
# Builds an oco-builder bootstrap environment inside a void-{glibc,musl}-full container
set -eu

# Repo mirrors and the GitHub API occasionally rate-limit a build
# runner; a transient 5xx should not throw away an image build.
xbps_install_retry() {
	local max=3 delay=5 i
	for i in $(seq 1 $max); do
		echo "==> xbps-install -S -y $* (attempt $i/$max)"
		xbps-install -S -y "$@" && return 0
		[ "$i" -lt "$max" ] && sleep "$delay"
	done
	return 1
}

OCO_REPO="https://repo.osowoso.org/${NAME}"
mkdir -p /etc/xbps.d
cp /usr/share/xbps.d/*-repository-*.conf /etc/xbps.d/
sed -i 's|repo-default|repo-ci|g' /etc/xbps.d/*-repository-*.conf
xbps_install_retry -Syu xbps
xbps_install_retry -yu
# GitHub-hosted Node action runtimes use the glibc ELF interpreter, even
# when the job container is based on musl.  The aarch64-musl image gets a
# private glibc runtime staged by the workflow; x86_64-musl keeps gcompat.
case "$NAME" in
	x86_64-musl) MUSL_COMPAT=gcompat ;;
	*) MUSL_COMPAT= ;;
esac
# shellcheck disable=SC2086
xbps_install_retry -y sudo bash curl git nodejs python3 xtools zstd base-chroot ${MUSL_COMPAT} ${EXTRA_PKGS:-}

# Keep the tree OUT of /void-packages: the ethereal chroot-style manages
# that path itself (symlink to the tree, emptied after every invocation)
# and re-executes the inner xbps-src as /void-packages/xbps-src.
useradd -G xbuilder -M builder
git clone --depth 1 https://github.com/void-linux/void-packages.git /oco-tree
chown -R builder:builder /oco-tree
cd /oco-tree
sudo -Eu builder common/travis/set_mirror.sh
sudo -Eu builder common/travis/prepare.sh
common/travis/fetch-xtools.sh

cat >> etc/conf <<'EOF'
XBPS_CCACHE=yes
XBPS_UPDATE_CHECK_VERBOSE=yes
EOF

echo "repository=${OCO_REPO}" > /etc/xbps.d/oco.conf
mkdir -p /var/db/xbps/keys /oco-tree/common/repo-keys
OCO_KEY="df:ec:10:ef:5c:03:e9:e0:9e:86:77:08:c2:b5:a8:cb.plist"
curl -fsSL "https://raw.githubusercontent.com/oSoWoSo/oco/OCO/oco-repo-key.plist" \
	-o "/var/db/xbps/keys/${OCO_KEY}" ||
 curl -fsSL "https://codeberg.org/oSoWoSo/oco/raw/branch/OCO/oco-repo-key.plist" \
	-o "/var/db/xbps/keys/${OCO_KEY}"
cp "/var/db/xbps/keys/${OCO_KEY}" /oco-tree/common/repo-keys/
OCO_URL="${OCO_REPO%/*}"
for _rrf in repos-remote.conf repos-remote-musl.conf repos-remote-aarch64.conf repos-remote-aarch64-musl.conf; do
        case "$_rrf" in
                repos-remote.conf)             _repo="$OCO_URL/x86_64" ;;
                repos-remote-musl.conf)        _repo="$OCO_URL/x86_64-musl" ;;
                repos-remote-aarch64.conf)     _repo="$OCO_URL/aarch64" ;;
                repos-remote-aarch64-musl.conf) _repo="$OCO_URL/aarch64-musl" ;;
        esac
        f=/oco-tree/etc/xbps.d/$_rrf
        [ -f "$f" ] || continue
        sed -i "1i repository=${_repo}" "$f"
done
xbps_install_retry
xbps_install_retry -R "$OCO_REPO" -y cosign
command -v cosign >/dev/null 2>&1 || {
	echo "==> ERROR: cosign was not installed from ${OCO_REPO}" >&2
	exit 1
}
xbps_install_retry -R "$OCO_REPO" -y surfer-cli || true
command -v surfer >/dev/null 2>&1 || {
	echo "==> ERROR: surfer-cli was not installed from ${OCO_REPO}" >&2
	echo "==> Falling back to npm (pinned)" >&2
	# Pinned on purpose: this ends up inside a published builder
	# image, so an unpinned global install is a supply chain hole.
	npm install -g "@cloudron/surfer@${SURFER_NPM_VERSION:-7.2.0}"
	command -v surfer >/dev/null 2>&1 || {
	    echo "==> ERROR: surfer was not installed from nodejs" >&2
	    exit 1
    }
}
install -m 0755 /tmp/oco-builder/oco-prepare /usr/local/bin/oco-prepare
chown -R builder:builder .
rm -rf hostdir/sources/* masterdir-*/var/cache/xbps/*
